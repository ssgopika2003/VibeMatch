{
  "name": "vibe-matching-fashion-system",
  "version": "1.0.0",
  "description": "AI-powered fashion recommendation platform with vibe matching",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/server.js",
    "seed": "node server/seed.js",
    "seed:admin": "node server/seed.js --admin-only",
    "seed:destroy": "node server/seed.js --destroy"
  },
  "keywords": ["fashion", "ecommerce", "mern", "vibe-matching"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "razorpay": "^2.9.2",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.1",
    "colors": "^1.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
