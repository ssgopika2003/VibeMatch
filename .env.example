# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/vibe-match

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=replace-with-a-long-random-secret

# Razorpay (Test Mode)
RAZORPAY=disable
RAZORPAY_DUMMY=disable
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Frontend URL
CLIENT_URL=http://localhost:5173

# Optional AI features; keep disabled until configured
AI=disable
AI_API_KEY=
AI_OLLAMA=http://localhost:11434
AI_OLLAMA_MODEL=phi3:latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
